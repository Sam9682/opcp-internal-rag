# Database Configuration
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Redis Configuration (Requirement 14.4)
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_EMBEDDING_TTL=86400
CACHE_RESPONSE_TTL=3600

# Model Configuration
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
DEVICE=cpu
GPU_COUNT=0

# Service Ports
EMBEDDING_PORT=8001
LLM_PORT=8002
API_PORT=8080
WEB_PORT=80

# API Configuration
API_URL=http://localhost:8080
JWT_SECRET=change-this-secret-key-in-production
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_AUTHENTICATED=1000

# RAG Configuration
MAX_PROMPT_TOKENS=4096
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_K=5
SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Ingestion Configuration
WATCH_INTERVAL=10

# Conversation Configuration
CONVERSATION_RETENTION_DAYS=30

# TLS/SSL Configuration (Requirement 15.2)
# Set ENABLE_TLS=true to enable HTTPS for API Gateway
ENABLE_TLS=false
SSL_KEYFILE=/app/certs/api-key.pem
SSL_CERTFILE=/app/certs/api-cert.pem

# Database SSL Configuration
# Options: disable, allow, prefer, require, verify-ca, verify-full
DB_SSL_MODE=prefer
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_ROOT_CERT=

# Database Encryption at Rest (Requirement 15.4)
# Generate a key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENCRYPT_SENSITIVE_FIELDS=false
